---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecTable from '@/components/SpecTable.astro';
import PhotoEditor from '@/components/editor/PhotoEditor.vue';
import { getVerifiedSpecPages, type SpecPage } from '@/lib/specs';
import { locales, type Locale } from '@/i18n/config';
import { getTranslations, useTranslations } from '@/i18n/ui';
import { localesWithDocument } from '@/lib/specs-locale';
import { relatedDocuments } from '@/lib/related-specs';
import { createSpecLabels } from '@/lib/spec-labels';

export async function getStaticPaths() {
  // Each locale is asked for its own verified specs, in parallel. A locale with
  // no content bundle yet contributes no paths rather than borrowing English
  // ones: a page whose `lang` claims de-DE over an English body is worse for a
  // reader, and for search, than no page at all.
  const perLocale = await Promise.all(
    locales.map(async (locale) => ({ locale, pages: await getVerifiedSpecPages(locale) })),
  );

  // Which locales publish each document, which is what each page hands the layout
  // as its hreflang set. Derived from the same query that decides which pages
  // exist, so the alternates cannot name a URL the build did not write.
  const published = perLocale.map(({ locale, pages }) => ({
    locale,
    documents: pages.map(({ entry }) => entry.data),
  }));

  return perLocale.flatMap(({ locale, pages }) =>
    pages.map((page) => ({
      params: {
        locale,
        country: page.entry.data.country,
        document: page.entry.data.document,
      },
      props: {
        page,
        locale,
        availableLocales: localesWithDocument(published, page.entry.data),
        // Related targets are resolved against this locale's own published
        // pages, so a link can never point at a URL the build did not write.
        relatedPages: relatedDocuments(page.entry.data).flatMap((id) => {
          const target = pages.find(
            (p) => p.entry.data.country === id.country && p.entry.data.document === id.document,
          );
          return target === undefined ? [] : [target];
        }),
      },
    })),
  );
}

export interface Props {
  page: SpecPage;
  /** Locale of this page, from the route. Every string below is loaded for it. */
  locale: Locale;
  /**
   * Locales with a verified spec for this same country and document, which is
   * the hreflang set the layout may advertise.
   */
  availableLocales: readonly Locale[];
  /**
   * Other spec pages this page links to, resolved against this locale's own
   * publications: a target this locale does not publish is simply not listed.
   */
  relatedPages: readonly SpecPage[];
}

const { page, locale, availableLocales, relatedPages } = Astro.props;
const { entry, spec } = page;
const { Content } = await render(entry);

const t = useTranslations(locale);
await t.load();

// The size on a related card and the size row of the spec table are the same
// measurement written twice, so both are derived from this one locale-aware
// formatter. See src/lib/spec-labels.ts.
const labels = createSpecLabels(locale, t.t);

// Serialize only the editor's copy so SSR and hydration use the same language.
const editorMessages = Object.fromEntries(
  Object.entries(await getTranslations(locale)).filter(
    ([key]) => (key.startsWith('editor.') || key.startsWith('unit.') || key === 'spec.background') && !key.endsWith('__note'),
  ),
);

// ISO 8601 and deliberately not localised: this date is the freshness marker on
// the numbers above it, and 2026-09-03 reads the same everywhere, where
// 09/03/2026 does not.
const checked = entry.data.sourceCheckedOn.toISOString().slice(0, 10);

// Both blocks carry `inLanguage`, which is what tells a crawler which of the
// hreflang alternates a block belongs to. The FAQ is the block that holds
// locale-specific prose — every question and answer a translator writes — so
// leaving it unmarked while marking the application block had it backwards.
const faqSchema =
  entry.data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        inLanguage: locale,
        mainEntity: entry.data.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

// The one human-readable string here is translated rather than left in English
// beside a claim that the page is German.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.t('schema.app-name', { documentName: entry.data.documentName }),
  inLanguage: locale,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// Mirrors the visible breadcrumb — {nav.home} linking to /{locale}, then the
// country name as plain text — so a crawler can correlate schema and markup.
// The last item is the current page and carries no `item`, which also means
// this block can never disagree with the canonical URL buildAlternates computes.
const origin = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.t('nav.home'),
      item: new URL(`/${locale}`, origin).href,
    },
    { '@type': 'ListItem', position: 2, name: entry.data.countryName },
  ],
};
---

<BaseLayout
  locale={locale}
  availableLocales={availableLocales}
  title={entry.data.title}
  description={entry.data.description}
  structuredData={[appSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <nav aria-label={t.t('aria.breadcrumb')} class="mb-4 text-sm text-ink-400">
    <a class="hover:text-brand-700" href={`/${locale}`}>{t.t('nav.home')}</a>
    <span aria-hidden="true"> / </span>
    <span>{entry.data.countryName}</span>
  </nav>

  <h1 class="text-3xl font-semibold tracking-tight text-ink-900">{entry.data.title}</h1>
  <p class="mt-3 max-w-2xl text-ink-600">{entry.data.description}</p>

  <div class="mt-8">
    <PhotoEditor spec={spec} locale={locale} messages={editorMessages} client:visible />
  </div>

  <section class="mt-12" aria-labelledby="requirements">
    <h2 id="requirements" class="text-xl font-semibold text-ink-900">
      {t.t('requirements.heading')}
    </h2>
    <div class="mt-4 rounded-xl border border-ink-200 p-5">
      <SpecTable spec={spec} locale={locale} />
      <p class="mt-4 text-xs text-ink-400">
        {t.t('requirements.source')}
        <a class="underline hover:text-brand-700" href={entry.data.sourceUrl} rel="nofollow noopener" target="_blank">
          {new URL(entry.data.sourceUrl).hostname}
        </a>
        · {t.t('requirements.checked')} {checked}
      </p>
    </div>
  </section>

  {
    entry.data.rejectionReasons.length > 0 && (
      <section class="mt-12" aria-labelledby="rejections">
        <h2 id="rejections" class="text-xl font-semibold text-ink-900">
          {t.t('rejections.heading')}
        </h2>
        <ul class="mt-4 space-y-2 text-ink-600">
          {entry.data.rejectionReasons.map((reason) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-bad-500" />
              <span>{reason}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="markdown mt-12 max-w-2xl">
    <Content />
  </div>

  {
    entry.data.faq.length > 0 && (
      <section class="mt-12" aria-labelledby="faq">
        <h2 id="faq" class="text-xl font-semibold text-ink-900">
          {t.t('faq.heading')}
        </h2>
        <dl class="mt-4 space-y-5">
          {entry.data.faq.map((item) => (
            <div>
              <dt class="font-medium text-ink-800">{item.q}</dt>
              <dd class="mt-1 text-ink-600">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    relatedPages.length > 0 && (
      <section class="mt-12" aria-labelledby="related">
        <h2 id="related" class="text-xl font-semibold text-ink-900">
          {t.t('related.heading')}
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {relatedPages.map(({ entry, spec, href }) => (
            <li>
              <a
                href={href}
                class="block h-full rounded-xl border border-ink-200 p-5 transition-colors hover:border-brand-500 hover:bg-brand-50"
              >
                <span class="block font-medium text-ink-900">{entry.data.documentName}</span>
                <span class="mt-1 block text-sm text-ink-600">{entry.data.countryName}</span>
                <span class="mt-3 block text-sm text-ink-400">{labels.size(spec)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
