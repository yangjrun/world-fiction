---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import type { PhotoSpec } from '@/lib/photo/types';
import { createSpecLabels } from '@/lib/spec-labels';

export interface Props {
  spec: PhotoSpec;
  /** Locale of the page rendering the table. Decides units and number format. */
  locale: Locale;
}

const { spec, locale } = Astro.props;

const t = useTranslations(locale);
await t.load();

// Every number, unit and pattern in the rows below comes from here, and so does
// the size printed on each home-page card, so the two cannot disagree about how
// a size is written. See src/lib/spec-labels.ts.
const labels = createSpecLabels(locale, t.t);

// Only some authorities publish an eye-line band. Where none exists the row is
// dropped rather than shown empty.
const eyeLine = labels.eyeLine(spec);

const rows: Array<{ label: string; value: string }> = [
  { label: t.t('spec.size'), value: labels.sizeWithPixels(spec) },
  { label: t.t('spec.head-height'), value: labels.headHeight(spec) },
  ...(eyeLine === null ? [] : [{ label: t.t('spec.eye-height'), value: eyeLine }]),
  // Background and file wording is spec data, translated with the content bundle
  // rather than the UI bundle.
  { label: t.t('spec.background'), value: spec.background.description },
  { label: t.t('spec.file'), value: labels.file(spec) },
];
---

<table class="w-full border-collapse text-sm">
  <caption class="sr-only">{labels.caption(spec)}</caption>
  <tbody>
    {
      rows.map((row) => (
        <tr class="border-b border-ink-200 last:border-0">
          <th scope="row" class="w-1/2 py-3 pr-4 text-left align-top font-medium text-ink-800">
            {row.label}
          </th>
          <td class="py-3 align-top text-ink-600">{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>
